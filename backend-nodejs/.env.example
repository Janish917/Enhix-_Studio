# ENHIX Backend (Render)
PORT=4000

# MongoDB Atlas connection string (required for persistent users on Render)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/enhix?retryWrites=true&w=majority

# Your Vercel site URL(s), comma-separated (optional, improves CORS logging)
# Example: https://enhix.vercel.app,https://www.yourdomain.com
FRONTEND_URL=https://your-app.vercel.app

# OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
