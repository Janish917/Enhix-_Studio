# ENHIX Frontend Environment Variables
# Copy this file to .env or configure in your hosting provider (e.g. Vercel)

# REQUIRED on Vercel: your Render backend URL (no trailing slash)
# Example: https://enhix-backend.onrender.com
# Leave EMPTY for local dev (Vite proxies /api → http://localhost:4000)
VITE_API_BASE_URL=https://YOUR-SERVICE.onrender.com

# Google OAuth Web Application Client ID
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# GitHub OAuth Application Client ID
VITE_GITHUB_CLIENT_ID=your-github-client-id
